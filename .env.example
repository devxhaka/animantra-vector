# --- Microsoft Edge Read Aloud (suara Gadis & Ardi) — TANPA key, aktif otomatis ---
# Layanan TIDAK RESMI: bisa berubah/diblokir sewaktu-waktu, hanya untuk pemakaian pribadi.
# Matikan dengan EDGE_TTS=0. Kecepatan bicara: +0% normal, +10% lebih cepat.
EDGE_TTS=1
EDGE_TTS_RATE=+5%

# --- Microsoft Azure Speech (suara penutur asli Indonesia: Gadis & Ardi) — DISARANKAN ---
# portal.azure.com → Create resource → "Speech service" → Pricing tier F0 (gratis)
# → Keys and Endpoint: salin KEY 1 dan Location/Region (misal southeastasia)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Kecepatan bicara (+0% normal, +10% lebih cepat)
AZURE_SPEECH_RATE=+5%
# Suara cadangan bila penyedia lain gagal
AZURE_SPEECH_VOICE_CADANGAN=id-ID-GadisNeural

# API key Gemini untuk suara (TTS). Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model TTS Gemini (ganti kalau Google merilis versi baru)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Port studio lokal
STUDIO_PORT=4321
BROWSER_EXECUTABLE=

# --- ElevenLabs (suara) — https://elevenlabs.io → Profile → API Keys ---
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 = kualitas terbaik · eleven_flash_v2_5 = ±setengah kredit, sedikit kurang ekspresif
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice ID cadangan bila Gemini gagal & harus pindah ke ElevenLabs
ELEVENLABS_VOICE_CADANGAN=EXAVITQu4vr4xnSDxMaL
