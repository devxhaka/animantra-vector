# --- Microsoft Edge Read Aloud (suara Gadis & Ardi) — TANPA key, aktif otomatis ---
# Layanan TIDAK RESMI: bisa berubah/diblokir sewaktu-waktu, hanya untuk pemakaian pribadi.
# Matikan dengan EDGE_TTS=0. Kecepatan bicara: +0% normal, +10% lebih cepat.
EDGE_TTS=1
EDGE_TTS_RATE=+5%

# --- Microsoft Azure Speech (suara penutur asli Indonesia: Gadis & Ardi) — DISARANKAN ---
# portal.azure.com → Create resource → "Speech service" → Pricing tier F0 (gratis)
# → Keys and Endpoint: salin KEY 1 dan Location/Region (misal southeastasia)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Kecepatan bicara (+0% normal, +10% lebih cepat)
AZURE_SPEECH_RATE=+5%
# Suara cadangan bila penyedia lain gagal
AZURE_SPEECH_VOICE_CADANGAN=id-ID-GadisNeural

# API key Gemini untuk suara (TTS). Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model TTS Gemini (ganti kalau Google merilis versi baru)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Port studio lokal
STUDIO_PORT=4321
BROWSER_EXECUTABLE=

# --- VoiceStudio lokal (suara kloning, mis. suara Bos) — via terowongan SSH / Tailscale ---
# JANGAN buka port 3900 ke internet. Dari VM studio, VoiceStudio harus terlihat lokal,
# mis. lewat terowongan SSH ke 127.0.0.1:3900 (lihat scripts/terowongan-voicestudio.sh).
# API key hanya dikirim lewat terowongan itu, tidak pernah lewat internet terbuka.
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
# Voice ID utama (dipakai job baru bila suara tidak diisi eksplisit).
# Daftar suara: GET /v1/audio/voices — mis. suara Bos = 44d7b906
VOICESTUDIO_VOICE=
# Model TTS VoiceStudio (bawaan tts-1)
VOICESTUDIO_MODEL=tts-1
# Endpoint SSH VM VoiceStudio untuk terowongan (host + port; user/key diatur script)
VOICESTUDIO_SSH_HOST=
VOICESTUDIO_SSH_PORT=2222
# File kunci SSH terowongan (dibuat di VM studio, kunci publiknya ditaruh di VM VoiceStudio)
VOICESTUDIO_KUNCI_SSH=~/.ssh/voicestudio-tunnel

# --- ElevenLabs (suara) — https://elevenlabs.io → Profile → API Keys ---
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 = kualitas terbaik · eleven_flash_v2_5 = ±setengah kredit, sedikit kurang ekspresif
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice ID cadangan bila Gemini gagal & harus pindah ke ElevenLabs
ELEVENLABS_VOICE_CADANGAN=EXAVITQu4vr4xnSDxMaL
